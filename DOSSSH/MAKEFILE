# DOSSSH - Open Watcom 1.9 / MS-DOS / 16-bit large memory model.

tcp_h_dir = ..\mTCP\src\TCPINC\
tcp_c_dir = ..\mTCP\src\TCPLIB\
common_h_dir = ..\mTCP\src\INCLUDE

memory_model = -ml
compile_options = -0 $(memory_model) -DCFG_H="dosssh.cfg" -oh -ok -ot -s -oa -ei -zp2 -we -ob -ol+ -oi+
compile_options += -i=$(tcp_h_dir) -i=$(common_h_dir)

tcpobjs = packet.obj arp.obj eth.obj ip.obj tcp.obj tcpsockm.obj udp.obj utils.obj dns.obj timer.obj ipasm.obj trace.obj
sshobjs = sshsha.obj sshcrypt.obj sshent.obj sshpkt.obj sshscan.obj sshnet.obj
objs = dosssh.obj encoding.obj config.obj vt100.obj util.obj input.obj

all : dosssh.exe

clean : .symbolic
  @del *.obj
  @del *.map
  @del dosssh.exe

.asm : $(tcp_c_dir)

.cpp : $(tcp_c_dir)

.asm.obj :
  *wasm -0 $(memory_model) $[*

.cpp.obj :
  *wpp $[* $(compile_options)

dosssh.exe : $(tcpobjs) $(sshobjs) $(objs)
  *wlink system dos option map option eliminate option stack=12288 name $@ file *.obj

